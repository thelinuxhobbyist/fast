# Copy this file to .env and fill the values
# Your Stripe secret key (starts with sk_live_ or sk_test_)
STRIPE_SECRET=
# Optional: webhook signing secret (from Stripe dashboard)
STRIPE_WEBHOOK_SECRET=
# Your Formspree endpoint URL, e.g. https://formspree.io/f/xldkyoqz
FORMSPREE_ENDPOINT=https://formspree.io/f/xldkyoqz
# Optional: a short identifier to check metadata for origin
SITE_IDENTIFIER=fastgraphicdesign
