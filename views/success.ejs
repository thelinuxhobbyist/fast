<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Payment Verified — Project Details</title>
  <link rel="stylesheet" href="css/style.css">
</head>
<body>
  <main class="container">
  <section class="card">
    <h1>Thank you — payment received</h1>
    <p style="color:#666;margin-bottom:18px">Your payment was successful. Please tell us about your project below so our team can begin work.</p>

    <div id="status" style="margin-bottom:12px;color:var(--green);font-weight:700">Payment verified</div>

    <div class="details-layout" style="gap:28px">
      <div class="details-main">
        <form id="projectForm" action="/success" method="POST">
      <input type="hidden" name="payment_intent" value="<%= payment_intent %>">
      <input type="hidden" name="csrf_token" value="<%= csrfToken %>">
          <% if (packageTitle) { %>
          <input type="hidden" name="package_id" value="<%= packageId %>">
          <input type="hidden" name="package_title" value="<%= packageTitle %>">
          <% } %>

      <div class="form-field">
        <label for="fullname">Full Name</label>
        <input type="text" id="fullname" name="fullname" required>
      </div>

      <div class="form-grid">
        <div class="form-field">
          <label for="fullname">Full Name</label>
          <input type="text" id="fullname" name="fullname" required>
        </div>
        <div class="form-field">
          <label for="email">Email Address</label>
          <input type="email" id="email" name="email" value="<%= prefill.email %>" required>
        </div>
      </div>

      <div class="form-field">
        <label for="purpose">What is the purpose of this design?</label>
        <input type="text" id="purpose" name="purpose" placeholder="Example: promoting an event, product advertising, brand awareness, social media post, etc." required>
      </div>

      <div class="form-field">
        <label for="business">Tell us about your business or brand</label>
        <textarea id="business" name="business" required style="min-height:120px"></textarea>
      </div>

      <div class="form-field">
        <label for="vision">Project details & vision</label>
        <textarea id="vision" name="vision" required style="min-height:120px"></textarea>
      </div>

      <div class="form-field">
        <label for="deadline">Preferred deadline or completion date</label>
        <input type="date" id="deadline" name="deadline" required>
      </div>

          <div class="form-actions">
            <button class="cta" type="submit">Submit Project Details</button>
          </div>
        </form>
      </div>

      <div class="details-price">
        <% if (packageTitle) { %>
        <div class="price-card" style="padding:16px;border-radius:8px">
          <div style="font-size:13px;color:var(--muted);">Purchased package</div>
          <div style="font-weight:800;margin-top:6px;font-size:18px"><%= packageTitle %></div>
          <div style="margin-top:12px;font-size:13px;color:var(--muted)">We will contact you at:</div>
          <div style="margin-top:6px;font-weight:700"><%= prefill.email %></div>
        </div>
        <% } else { %>
        <div class="price-card" style="padding:16px;border-radius:8px">
          <div style="font-weight:700">Order summary</div>
          <div style="margin-top:12px;color:var(--muted)">No package data available.</div>
        </div>
        <% } %>
      </div>
    </div>
  </section>
  </main>
  <script>
    // client-side: ensure deadline min is 10 days from today
    document.addEventListener('DOMContentLoaded', function(){
      var d = new Date(); d.setHours(0,0,0,0); d.setDate(d.getDate()+10);
      function toISODate(x){return x.getFullYear()+'-'+String(x.getMonth()+1).padStart(2,'0')+'-'+String(x.getDate()).padStart(2,'0');}
      var el = document.getElementById('deadline'); if (el) el.min = toISODate(d);
    });

    // Show a simple success status when Stripe returns a payment_intent query param
    (function(){
      try {
        var url = new URL(window.location.href);
        var paymentIntent = url.searchParams.get('payment_intent');
        if (!paymentIntent) return;

        // If we've already handled this payment intent in this browser session,
        // strip the query param immediately to avoid re-processing/loops.
        var seenKey = 'seen_pi_' + paymentIntent;
        if (sessionStorage.getItem(seenKey)) {
          try { history.replaceState(null, '', window.location.pathname); } catch(e) {}
          return;
        }

        // Mark as seen for this session and show a success status
        try { sessionStorage.setItem(seenKey, '1'); } catch(e) {}
        var st = document.getElementById('status');
        if (st) st.innerText = 'Payment verified — thank you!';

        // Remove the query params from the URL after a short delay so analytics
        // and any expired observers can still access the param on first load.
        setTimeout(function(){
          try { history.replaceState(null, '', window.location.pathname); } catch(e) { /* ignore */ }
        }, 800);
      } catch (e) { /* ignore URL parsing errors */ }
    })();
  </script>
</body>
</html>
